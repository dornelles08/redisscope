{
  "name": "redisscope-backend",
  "version": "0.1.0",
  "description": "RedisScope backend — Fastify + TypeScript",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": ["redis", "redisscope"],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
