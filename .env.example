# RedisScope — variáveis de ambiente (copie para .env e ajuste)
# NUNCA versione senhas/chaves reais no repositório. Nunca use os exemplos abaixo em produção.

# --- Backend ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# Autenticação (login/senha — v1)
# ATENÇÃO: defina credenciais fortes. Os exemplos aqui são fracos e conhecidos — TROQUE.
AUTH_USERNAME=admin
AUTH_PASSWORD=troque-por-senha-forte-123
AUTH_SECRET=troque-por-segredo-aleatorio-com-32-mais-caracteres-123456
AUTH_TOKEN_EXPIRY_SECONDS=43200

# Criptografia das credenciais Redis (AES-256-GCM)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 32 bytes em hexadecimal = 64 caracteres. NUNCA use zeros em produção.
ENCRYPTION_KEY=troque-por-64-caracteres-hex-gerados-aleatoriamente-000000000

# Persistência
DATA_DIR=/app/data
DATA_FILE=connections.json

# Proteção SSRF — hosts permitidos para conexões Redis (separados por vírgula)
# Vazio = permite redes privadas (recomendado para homelab) e bloqueia apenas loopback/metadata.
# Ex.: ALLOWED_HOSTS=redis,10.0.0.10
ALLOWED_HOSTS=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Redis (timeouts)
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000

# --- Frontend (apenas build-time, via Vite) ---
# O frontend usa /api relativo — Nginx faz proxy para backend:3000.
# Em dev, o Vite faz proxy para localhost:3000.
VITE_API_BASE_URL=/api

# --- Docker ---
FRONTEND_PORT=8080
